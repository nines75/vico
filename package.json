{
  "name": "vico",
  "description": "Video Speed Controller",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wxt --browser firefox",
    "dev:chrome": "wxt",
    "build": "wxt build --browser firefox",
    "build:chrome": "wxt build",
    "zip": "wxt zip --browser firefox",
    "postinstall": "wxt prepare",
    "preversion": "pnpm check",
    "compile": "vue-tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier . --write --list-different",
    "format:ci": "prettier . --check",
    "check": "concurrently 'pnpm build' 'pnpm compile' 'pnpm lint' 'pnpm format:ci'"
  },
  "dependencies": {
    "debounce": "^3.0.0",
    "deepmerge-ts": "^8.0.2",
    "modern-normalize": "^3.0.1",
    "ts-extras": "^2.0.0",
    "type-fest": "^5.10.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint-plugin-vue": "^10.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  }
}
