{
  "name": "vico",
  "description": "Video Speed Controller",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.19.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "wxt --browser firefox --mv2",
    "build": "wxt build --browser firefox --mv2",
    "zip": "wxt zip --browser firefox --mv2",
    "postinstall": "wxt prepare",
    "preversion": "pnpm check",
    "compile": "tsc --noEmit",
    "lint": "eslint --max-warnings=0",
    "format": "prettier . --write --list-different",
    "format:ci": "prettier . --check",
    "check": "concurrently 'pnpm build' 'pnpm compile' 'pnpm lint' 'pnpm format:ci'"
  },
  "dependencies": {
    "defu": "^6.1.7",
    "ts-extras": "^1.3.0",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "wxt": "^0.21.4"
  }
}
